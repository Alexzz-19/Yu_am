# apps/web/.env.example — Plantilla de variables del Frontend (SIN valores reales)
# Copiar a `.env.local` y completar localmente. Nunca commitear `.env.local`.

# URL pública del proyecto Supabase (Dashboard de Supabase > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública anónima de Supabase (Project Settings > API > anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_aqui

# Token de acceso personal de Figma (solo desarrollo local con Figma MCP)
FIGMA_ACCESS_TOKEN=tu_figma_token_aqui
