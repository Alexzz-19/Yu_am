# apps/web/.env.example — Frontend variables template (NO real values)
# Copy to `.env.local` and complete locally. Never commit `.env.local`.

# Public Supabase project URL (Supabase Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=tu_url_de_supabase_aqui

# Supabase public anonymous key (Project Settings > API > anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_clave_anon_aqui

# Secretos exclusivos del servidor. Nunca usar el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=tu_clave_service_role_aqui
GEMINI_API_KEY=tu_api_key_de_google_aqui
GEMINI_MODEL=gemini-2.5-flash
NEXT_PUBLIC_GA_ID=G-TU_IDENTIFICADOR

# Site key de Cloudflare Turnstile. Configurar su secret en Supabase Auth > CAPTCHA.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=tu_site_key_de_recaptcha_o_turnstile

# Personal Figma access token (local development with Figma MCP only)
FIGMA_ACCESS_TOKEN=tu_figma_token_aqui
