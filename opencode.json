{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".ai/AGENTS.md"
  ],
  "references": {
    "frontend": {
      "path": "apps/web",
      "description": "Subagente Frontend: aplicacion Next.js (App Router, TypeScript, Tailwind, Figma MCP)"
    },
    "database": {
      "path": "packages/database",
      "description": "Subagente Backend: esquemas PostgreSQL, RLS y cliente Supabase"
    },
    "project-docs": {
      "path": "docs",
      "description": "Subagente Documentador: specs SDD, Obsidian y bitacoras"
    }
  },
  "mcp": {
    "supabase": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@supabase/mcp-server"
      ],
      "enabled": true,
      "environment": {
        "SUPABASE_URL": "{env:SUPABASE_URL}",
        "SUPABASE_SERVICE_ROLE_KEY": "{env:SUPABASE_SERVICE_ROLE_KEY}"
      }
    },
    "figma": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-figma"
      ],
      "enabled": true,
      "environment": {
        "FIGMA_ACCESS_TOKEN": "{env:FIGMA_ACCESS_TOKEN}"
      }
    }
  }
}
