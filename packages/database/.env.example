# packages/database/.env.example — Private Supabase & database variables (NO real values)

# Supabase private service role key (never expose client-side)
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_privada

# Direct PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@db.tu-proyecto.supabase.co:5432/postgres

# AI and bioreactor sensors
DEEPSEEK_API_KEY=tu_deepseek_key
